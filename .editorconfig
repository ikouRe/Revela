root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kt,xml}]
indent_size = 4

[*.md]
# deux espaces en fin de ligne = retour à la ligne en Markdown
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
